---
// Le dernier maillon est la page courante : il n'a pas de `href`, et c'est ce
// qui le distingue. Pas de booléen `isCurrent` à tenir à jour en double.
interface Props {
	items: { label: string; href?: string }[];
}

const { items }: Props = Astro.props;
---

<nav aria-label="Fil d'ariane" class="font-mono text-xs">
    <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
        {items.map((item, index) => (
            <li class="flex items-center gap-x-2">
                {index > 0 && (
                    <span aria-hidden="true" class="text-rule">/</span>
                )}
                {item.href ? (
                    <a
                        href={item.href}
                        class="text-muted underline decoration-rule decoration-1 underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
                    >
                        {item.label}
                    </a>
                ) : (
                    <span aria-current="page" class="text-ink">{item.label}</span>
                )}
            </li>
        ))}
    </ol>
</nav>
