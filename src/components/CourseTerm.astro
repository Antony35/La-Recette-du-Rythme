---
import glossary from "@/content/glossary.json";

interface Props {
	term: keyof typeof glossary;
}

const entry = glossary[Astro.props.term];
const id = `term-${crypto.randomUUID()}`;
---

<span class="course-term not-prose">
	<button type="button" aria-describedby={id}>{entry.label}</button>
	<span id={id} role="tooltip" class="course-term-definition">{entry.definition}</span>
</span>

<script>
	for (const term of document.querySelectorAll<HTMLElement>(".course-term")) {
		const button = term.querySelector("button")!;
		const tooltip = term.querySelector<HTMLElement>("[role=tooltip]")!;
		const show = () => {
			delete term.dataset.dismissed;
			const rect = button.getBoundingClientRect();
			const left = Math.max(16, Math.min(rect.left, window.innerWidth - tooltip.offsetWidth - 16));
			tooltip.style.left = `${left}px`;
			tooltip.style.top = `${rect.bottom + tooltip.offsetHeight > window.innerHeight ? rect.top - tooltip.offsetHeight : rect.bottom}px`;
		};
		term.addEventListener("pointerenter", show);
		button.addEventListener("focus", show);
		button.addEventListener("click", show);
	}
	const dismiss = () => {
		for (const term of document.querySelectorAll<HTMLElement>(".course-term")) {
			term.dataset.dismissed = "true";
		}
	};
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") dismiss();
	});
	document.addEventListener("scroll", dismiss, { passive: true });
</script>
