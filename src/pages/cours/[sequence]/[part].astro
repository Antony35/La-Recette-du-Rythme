---
import { getCollection, getEntry, render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import Lesson from "@/layouts/Lesson.astro";

export const getStaticPaths = (async () => {
	const parts = await getCollection("parts");

	return parts.map((part) => {
		return {
			params: {
				part: part.id,
				sequence: part.data.sequence.id,
			},
			props: {
				part: part,
			},
		};
	});
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { part }: Props = Astro.props;

// part.data.sequence est un pointeur { collection, id } : getEntry() le résout.
const sequence = await getEntry(part.data.sequence);
const { Content } = await render(part);
---

<Lesson title={part.data.title} sequenceTitle={sequence.data.title}>
    <Content />
</Lesson>
