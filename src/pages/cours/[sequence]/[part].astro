---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import Lesson from "@/layouts/Lesson.astro";
import { buildCourse, flattenCourse, getNeighbours } from "@/lib/course";

export const getStaticPaths = (async () => {
	const [sequences, parts] = await Promise.all([
		getCollection("sequences"),
		getCollection("parts"),
	]);

	// L'arbre trié puis aplati donne l'ordre de lecture réel du cours, séquences
	// comprises. Il est calculé une seule fois ici : getStaticPaths ne s'exécute
	// qu'au démarrage du build, alors que le frontmatter d'une page tourne pour
	// chaque page générée.
	const course = buildCourse(sequences, parts);
	const flat = flattenCourse(course);

	// On parcourt l'arbre plutôt que la collection brute : chaque partie arrive
	// avec sa séquence et ses sœurs déjà triées, donc plus besoin de getEntry()
	// dans la page ni d'un second filtrage pour le rail de navigation.
	return course.flatMap((sequence) =>
		sequence.parts.map((part) => {
			const { previous, next } = getNeighbours(flat, part.id);

			return {
				params: {
					part: part.id,
					sequence: sequence.id,
				},
				props: {
					part,
					sequence,
					parts: sequence.parts,
					previous,
					next,
				},
			};
		}),
	);
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { part, sequence, parts, previous, next }: Props = Astro.props;

const { Content } = await render(part);
---

<Lesson
    part={part}
    sequence={sequence}
    parts={parts}
    previous={previous}
    next={next}
>
    <Content />
</Lesson>
