---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import Sequence from "@/layouts/Sequence.astro";
import { byOrder } from "@/lib/course";

export const getStaticPaths = (async () => {
	const sequences = await getCollection("sequences");

	return sequences.map((sequence) => {
		return {
			params: {
				sequence: sequence.id,
			},
			props: {
				sequence: sequence,
			},
		};
	});
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { sequence }: Props = Astro.props;

// Le second argument de getCollection() est un prédicat : Astro filtre pour nous.
const parts = (
	await getCollection("parts", (part) => part.data.sequence.id === sequence.id)
).toSorted(byOrder);

const { Content } = await render(sequence);
---

<Sequence sequence={sequence} parts={parts}>
    <Content />
</Sequence>
