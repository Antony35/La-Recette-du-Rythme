---
import type { CollectionEntry } from "astro:content";
import StrudelRepl from "@/components/StrudelRepl.vue";
import VideoPlaceholder from "@/components/VideoPlaceholder.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { type buildCourse, flattenCourse } from "@/lib/course";
import { formatDuration, plural, splitTitle } from "@/lib/format";
import { levels } from "@/lib/levels";
import { withBase } from "@/lib/url";

// Le type est dérivé de buildCourse plutôt que réécrit à la main : le jour où
// l'arbre change de forme, ce fichier suit tout seul. `typeof buildCourse<…>`
// instancie la fonction générique avec les types réels des collections.
type Course = ReturnType<
	typeof buildCourse<CollectionEntry<"sequences">, CollectionEntry<"parts">>
>;

interface Props {
	course: Course;
}

const { course }: Props = Astro.props;

// Agrégations d'affichage, calculées à partir des props reçues : le layout ne
// charge rien, il ne fait que résumer ce que la page lui a donné.
//
// La durée totale vient des séquences (durée *prévue*), pas des parties : tant
// que le cours n'est pas entièrement rédigé, la somme des parties mentirait.
const totalMinutes = course.reduce(
	(total, sequence) => total + sequence.data.durationMinutes,
	0,
);

// Le vrai point de départ : la première partie rédigée dans l'ordre de lecture.
const start = flattenCourse(course)[0];

// Les chiffres clés, à la manière du bandeau « Skolae, c'est… ».
const figures = [
	{ value: String(course.length), label: "séquences" },
	{ value: formatDuration(totalMinutes), label: "de pratique" },
	{ value: String(Object.keys(levels).length), label: "niveaux" },
];

// Le sommaire est regroupé par niveau : chaque niveau est un grand aplat pastel,
// comme les blocs de couleur de la charte SKOLAE.
const byLevel = Object.entries(levels).map(([level, meta]) => ({
	level: Number(level),
	...meta,
	sequences: course.filter((sequence) => sequence.data.level === Number(level)),
}));
---

<BaseLayout title="La Recette du Rythme — créer de la musique sur le web avec Strudel">
    <section aria-labelledby="titre">
        <p class="inline-block rounded-full bg-lemon px-4 py-1.5 text-sm font-bold text-night">
            Cours de live coding · JavaScript
        </p>
        <h1 id="titre" class="display-title mt-6 max-w-4xl text-5xl text-balance sm:text-7xl lg:text-8xl">
            Créer de la musique sur le web avec Strudel
        </h1>
        <p class="mt-8 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">
            Quelques lignes de JavaScript, un navigateur et un casque. Tu écris du
            code, tu l'évalues, tu entends le résultat — sans logiciel à installer
            ni solfège à connaître.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-3">
            {start && (
                <a
                    href={withBase(`/cours/${start.data.sequence.id}/${start.id}`)}
                    class="rounded-full bg-accent px-7 py-3.5 font-extrabold text-ground transition-opacity hover:opacity-85"
                >
                    Commencer : {splitTitle(start.data.title).main} →
                </a>
            )}
            <a
                href="#sommaire"
                class="rounded-full border-2 border-ink px-7 py-3 font-extrabold transition-colors hover:bg-ink hover:text-ground"
            >
                Voir le sommaire
            </a>
        </div>
    </section>

    <dl class="mt-16 grid grid-cols-3 gap-3 sm:gap-6">
        {figures.map((figure) => (
            <div class="flex flex-col rounded-3xl bg-surface p-5 sm:p-8">
                {/* Le terme suit la valeur à l'écran, mais le précède dans le
                    code : c'est l'ordre qu'impose <dl>, et celui qu'entend un
                    lecteur d'écran (« séquences : 8 »). */}
                <dt class="order-2 mt-2 text-sm font-semibold text-muted sm:text-base">{figure.label}</dt>
                <dd class="display-title order-1 text-4xl tabular-nums sm:text-7xl">{figure.value}</dd>
            </div>
        ))}
    </dl>

    <div class="mt-16 grid gap-10 lg:grid-cols-2 lg:items-center">
        <VideoPlaceholder
            title="Présentation du cours"
            duration="2 min 45"
            format="alternance des deux voix face caméra, captures d'écran de Strudel en incrustation"
        />

        <StrudelRepl client:visible label="Essaie tout de suite" code={'s("bd*4")'}>
            <p class="mt-5 max-w-xl text-sm leading-relaxed text-muted">
                Ce n'est pas un fichier son : ce motif est exécuté dans le moteur
                audio de ton navigateur, et tu peux le réécrire. <code
                    class="rounded-md bg-surface px-1 py-0.5 font-mono text-xs text-ink">bd</code
                > est une grosse caisse, <code
                    class="rounded-md bg-surface px-1 py-0.5 font-mono text-xs text-ink">*4</code
                > la répète quatre fois par cycle. Essaie <code
                    class="rounded-md bg-surface px-1 py-0.5 font-mono text-xs text-ink">s("bd*4, hh*8")</code
                >.
            </p>
        </StrudelRepl>
    </div>

    <section class="mt-24" aria-labelledby="sommaire">
        <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
            <h2 id="sommaire" class="display-title text-5xl sm:text-6xl">Sommaire</h2>
            <p class="text-sm font-semibold text-muted tabular-nums">
                {plural(course.length, "séquence", "séquences")} · {formatDuration(totalMinutes)}
            </p>
        </div>

        <div class="mt-10 flex flex-col gap-6">
            {byLevel.map((group) => (
                <section
                    class:list={["rounded-3xl p-6 text-night sm:p-10", group.fill]}
                    aria-labelledby={`niveau-${group.level}`}
                >
                    <h3 id={`niveau-${group.level}`} class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                        <span class="text-sm font-bold text-night-soft">Niveau {group.level}</span>
                        <span class="display-title text-3xl sm:text-4xl">{group.label}</span>
                    </h3>

                    <ol class="mt-8 grid gap-3 md:grid-cols-2">
                        {group.sequences.map((sequence) => (
                            <li>
                                <a
                                    href={withBase(`/cours/${sequence.id}`)}
                                    class="group flex h-full flex-col rounded-xl bg-snow/60 p-5 transition-colors hover:bg-snow"
                                >
                                    <span class="text-sm font-bold text-night-soft">
                                        Séquence {sequence.data.order} · {formatDuration(sequence.data.durationMinutes)}
                                    </span>
                                    <span class="mt-2 text-lg leading-snug font-extrabold text-balance underline decoration-transparent decoration-2 underline-offset-4 transition-colors group-hover:decoration-night">
                                        {sequence.data.title}
                                    </span>
                                    <span class="mt-2 text-sm leading-relaxed text-night-soft">
                                        {sequence.data.objective}
                                    </span>
                                    <span class="mt-auto pt-4 text-sm font-bold">
                                        {sequence.parts.length === 0
                                            ? "À venir"
                                            : plural(sequence.parts.length, "sous-séquence", "sous-séquences")}
                                    </span>
                                </a>
                            </li>
                        ))}
                    </ol>
                </section>
            ))}
        </div>
    </section>
</BaseLayout>
