---
import type { CollectionEntry } from "astro:content";
import StrudelRepl from "@/components/StrudelRepl.vue";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { buildCourse } from "@/lib/course";
import { withBase } from "@/lib/url";

// Le type est dérivé de buildCourse plutôt que réécrit à la main : le jour où
// l'arbre change de forme, ce fichier suit tout seul. `typeof buildCourse<…>`
// instancie la fonction générique avec les types réels des collections.
type Course = ReturnType<
	typeof buildCourse<CollectionEntry<"sequences">, CollectionEntry<"parts">>
>;

interface Props {
	course: Course;
	// Optionnel pour de bon : tant qu'aucune partie n'est rédigée, le cours n'a
	// pas de point de départ, et le bouton « commencer » n'a rien à pointer.
	start?: CollectionEntry<"parts">;
}

const { course, start }: Props = Astro.props;

// Agrégations d'affichage, calculées à partir des props reçues : le layout ne
// charge rien, il ne fait que résumer ce que la page lui a donné.
const allParts = course.flatMap((sequence) => sequence.parts);
const totalMinutes = allParts.reduce(
	(total, part) => total + part.data.durationMinutes,
	0,
);

const plural = (count: number, one: string, many: string) =>
	`${count} ${count > 1 ? many : one}`;

const summary = [
	plural(course.length, "séquence", "séquences"),
	plural(allParts.length, "partie", "parties"),
	`${totalMinutes} min`,
].join(" · ");
---

<BaseLayout title="La Recette du Rythme">
    <h1 class="font-mono text-3xl font-bold tracking-tight text-balance sm:text-4xl">
        Introduction au live coding
    </h1>
    <p class="mt-5 max-w-xl leading-relaxed text-muted">
        Du VST à Strudel en passant par la Web Audio API : comment le code s'est
        mis au service du son, et comment s'en servir soi-même.
    </p>

    <div class="mt-14">
        <StrudelRepl client:visible label="Essaie tout de suite" code={'s("bd*4")'}>
            <p class="mt-5 max-w-xl text-sm leading-relaxed text-muted">
                Ce n'est pas un fichier son : ce motif est exécuté dans le moteur
                audio de ton navigateur, et tu peux le réécrire. <code
                    class="bg-surface px-1 py-0.5 font-mono text-xs text-ink">bd</code
                > est une grosse caisse, <code
                    class="bg-surface px-1 py-0.5 font-mono text-xs text-ink">*4</code
                > la répète quatre fois par cycle. Essaie <code
                    class="bg-surface px-1 py-0.5 font-mono text-xs text-ink">s("bd*4, hh*8")</code
                >, ou remplace <code
                    class="bg-surface px-1 py-0.5 font-mono text-xs text-ink">hh</code
                > par <code
                    class="bg-surface px-1 py-0.5 font-mono text-xs text-ink">sd</code
                >.
            </p>
        </StrudelRepl>
    </div>

    <section class="mt-16" aria-labelledby="public">
        <h2
            id="public"
            class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-muted"
        >
            À qui ça s'adresse
        </h2>
        <ul class="mt-5 flex max-w-xl flex-col gap-3 leading-relaxed">
            <li class="border-l-2 border-rule pl-5">
                Tu écris du code et tu voudrais en faire de la musique.
            </li>
            <li class="border-l-2 border-rule pl-5">
                Tu n'as pas besoin de savoir lire une partition : le vocabulaire
                utile est expliqué au fur et à mesure.
            </li>
            <li class="border-l-2 border-rule pl-5">
                Un navigateur suffit. Rien à installer, rien à acheter.
            </li>
        </ul>
    </section>

    <section class="mt-16" aria-labelledby="sommaire">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
            <h2
                id="sommaire"
                class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-muted"
            >
                Sommaire
            </h2>
            <p class="font-mono text-xs text-muted tabular-nums">{summary}</p>
        </div>

        <ul class="mt-8 flex flex-col gap-10">
            {course.map((sequence) => (
                <li class="border-l-2 border-rule pl-6 transition-colors hover:border-accent">
                    <p class="font-mono text-xs font-bold uppercase tracking-[0.16em] text-accent">
                        Séquence {sequence.data.order}
                    </p>
                    <h3 class="mt-3 text-lg leading-snug font-semibold text-balance">
                        <a
                            href={withBase(`/cours/${sequence.id}`)}
                            class="underline decoration-rule decoration-1 underline-offset-4 transition-colors hover:decoration-accent"
                        >
                            {sequence.data.title}
                        </a>
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-muted">
                        {sequence.data.objective}
                    </p>
                    <p class="mt-3 font-mono text-xs text-muted tabular-nums">
                        {sequence.parts.length === 0
                            ? "à venir"
                            : plural(sequence.parts.length, "partie", "parties")}
                    </p>
                </li>
            ))}
        </ul>
    </section>

    {start && (
        <a
            href={withBase(`/cours/${start.data.sequence.id}/${start.id}`)}
            class="mt-14 flex flex-col gap-1.5 border-t border-rule pt-8 group"
        >
            <span class="font-mono text-xs uppercase tracking-[0.16em] text-muted">
                Commencer ici →
            </span>
            <span class="leading-snug font-medium underline decoration-rule decoration-1 underline-offset-4 transition-colors group-hover:decoration-accent">
                {start.data.title}
            </span>
        </a>
    )}
</BaseLayout>
