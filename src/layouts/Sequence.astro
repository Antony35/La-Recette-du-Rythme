---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
	sequence: CollectionEntry<"sequences">;
	parts: CollectionEntry<"parts">[];
}

const { sequence, parts }: Props = Astro.props;
---

<BaseLayout title={sequence.data.title}>
    <h1>{sequence.data.title}</h1>
    <p>{sequence.data.objective}</p>
    <ul>
        {parts.map((part) => (
            <li>
                <a href={`/cours/${sequence.id}/${part.id}`}>{part.data.title}</a>
            </li>
        ))}
    </ul>
    <slot />
</BaseLayout>
