---
import "@/styles/global.css";
import { withBase } from "@/lib/url";

// Les fichiers de public/ sont servis sous la base, eux aussi : un chemin en dur
// vers la racine donnerait un 404 une fois le site en ligne.
// (Ce commentaire est dans le frontmatter, donc il n'est pas envoyé au
// navigateur — un commentaire HTML, lui, part dans chaque page.)

// Le dépôt est une URL externe : surtout pas de withBase() dessus, qui la
// préfixerait comme un chemin interne.
const repository = "https://github.com/Antony35/La-Recette-du-Rythme";

// Sur <body>, flex-col combiné à `grow` sur <main> garde le pied de page en bas
// même sur une page courte, sans hauteur fixe ni positionnement absolu.

interface Props {
	title: string;
}
const { title }: Props = Astro.props;
---

<html lang="fr">
    <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")}/>
        <link rel="icon" href={withBase("/favicon.ico")}/>
        <meta name="generator" content={Astro.generator}/>
        <title>{title}</title>

        {/*
          `is:inline` : Astro laisse ce script tel quel dans le <head> au lieu de
          le regrouper avec les autres. Il s'exécute donc AVANT le premier rendu,
          ce qui évite le flash de thème clair sur un visiteur qui a choisi
          sombre. Un script différé arriverait toujours trop tard.
          try/catch : localStorage lève en navigation privée sur certains
          navigateurs, et le site doit rester affichable dans ce cas.
        */}
        <script is:inline>
            try {
                const choice = localStorage.getItem("theme");
                if (choice === "light" || choice === "dark") {
                    document.documentElement.dataset.theme = choice;
                }
            } catch {}
        </script>
    </head>

    <body class="flex min-h-dvh flex-col bg-ground font-sans text-ink antialiased">
        <a
            href="#contenu"
            class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-accent focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:text-ground"
        >
            Aller au contenu
        </a>

        <header class="border-b border-rule">
            <div class="mx-auto flex w-full max-w-5xl items-center justify-between gap-4 px-6 py-4 sm:px-8">
                <a
                    href={withBase("/")}
                    class="font-mono text-sm font-bold tracking-tight transition-colors hover:text-accent"
                >
                    La Recette du Rythme
                </a>

                <!--
                  aria-pressed plutôt qu'un simple bouton : il annonce l'état
                  courant, pas seulement l'action. Le libellé est mis à jour par
                  le script ci-dessous, jamais en dur, pour qu'il reste vrai.
                -->
                <button
                    id="theme-toggle"
                    type="button"
                    aria-pressed="false"
                    class="rounded-xs border border-rule px-3 py-1.5 font-mono text-xs tracking-[0.1em] uppercase transition-colors hover:border-accent hover:text-accent"
                >
                    Thème
                </button>
            </div>
        </header>

        <main id="contenu" class="mx-auto w-full max-w-5xl grow px-6 py-14 sm:px-8 sm:py-20">
            <slot/>
        </main>

        <footer class="border-t border-rule">
            <div class="mx-auto flex w-full max-w-5xl flex-col gap-2 px-6 py-8 font-mono text-xs text-muted sm:flex-row sm:items-center sm:justify-between sm:px-8">
                <p>Cours en construction.</p>
                <a
                    href={repository}
                    class="underline decoration-rule decoration-1 underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
                >
                    Code source
                </a>
            </div>
        </footer>

        {/*
          Une vingtaine de lignes sans framework : le bouton n'a pas besoin d'un
          îlot, donc il n'en aura pas. `is:inline` évite qu'Astro n'en fasse un
          module à télécharger séparément.
        */}
        <script is:inline>
            (() => {
                const root = document.documentElement;
                const button = document.getElementById("theme-toggle");
                if (!button) return;

                const systemDark = window.matchMedia("(prefers-color-scheme: dark)");

                // Le thème effectif : le choix stocké s'il existe, sinon le système.
                const current = () =>
                    root.dataset.theme || (systemDark.matches ? "dark" : "light");

                const render = () => {
                    const dark = current() === "dark";
                    button.textContent = dark ? "Clair" : "Sombre";
                    button.setAttribute("aria-pressed", String(dark));
                    // Le libellé dit ce que le clic va faire ; aria-label dit où
                    // l'on en est. Les deux sont nécessaires et différents.
                    button.setAttribute(
                        "aria-label",
                        dark ? "Thème sombre actif. Passer au thème clair" : "Thème clair actif. Passer au thème sombre",
                    );
                };

                button.addEventListener("click", () => {
                    const next = current() === "dark" ? "light" : "dark";
                    root.dataset.theme = next;
                    try {
                        localStorage.setItem("theme", next);
                    } catch {}
                    render();
                });

                // Tant qu'aucun choix n'a été fait, suivre le système en direct.
                systemDark.addEventListener("change", () => {
                    if (!root.dataset.theme) render();
                });

                render();
            })();
        </script>
    </body>
</html>
