---
import "@/styles/global.css";
import { withBase } from "@/lib/url";

interface Props {
	title: string;
}
const { title }: Props = Astro.props;

// Les fichiers de public/ sont servis sous la base, eux aussi : un chemin en dur
// vers la racine donnerait un 404 une fois le site en ligne.
// (Ce commentaire est dans le frontmatter, donc il n'est pas envoyé au
// navigateur — un commentaire HTML, lui, part dans chaque page.)

// Le dépôt est une URL externe : surtout pas de withBase() dessus, qui la
// préfixerait comme un chemin interne.
const repository = "https://github.com/Antony35/La-Recette-du-Rythme";

// Sur <body>, flex-col combiné à `grow` sur <main> garde le pied de page en bas
// même sur une page courte, sans hauteur fixe ni positionnement absolu.

// Les polices du texte et des titres sont visibles dès le premier écran : les
// précharger évite de voir la police de repli remplacée une seconde plus tard.
// `crossorigin` est obligatoire sur un préchargement de police, même servie par
// le même domaine — sans lui, le navigateur télécharge le fichier deux fois.
const preloadedFonts = [
	"/fonts/manrope-variable.woff2",
	"/fonts/archivo-condensed-black-italic.woff2",
];

const navigation = [
	{ label: "Cours", href: withBase("/") },
	{ label: "Sources", href: withBase("/sources") },
];

// Comparaison sans la barre finale : `/sources` et `/sources/` sont la même page.
const trim = (path: string) => path.replace(/\/+$/, "");
const isCurrent = (href: string) => trim(Astro.url.pathname) === trim(href);
---

<html lang="fr">
    <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")}/>
        <link rel="icon" href={withBase("/favicon.ico")}/>
        <meta name="generator" content={Astro.generator}/>
        <title>{title}</title>
        {preloadedFonts.map((font) => (
            <link rel="preload" as="font" type="font/woff2" href={withBase(font)} crossorigin />
        ))}

        {/*
          `is:inline` : Astro laisse ce script tel quel dans le <head> au lieu de
          le regrouper avec les autres. Il s'exécute donc AVANT le premier rendu,
          ce qui évite le flash de thème clair sur un visiteur qui a choisi
          sombre. Un script différé arriverait toujours trop tard.
          try/catch : localStorage lève en navigation privée sur certains
          navigateurs, et le site doit rester affichable dans ce cas.
        */}
        <script is:inline>
            try {
                const choice = localStorage.getItem("theme");
                if (choice === "light" || choice === "dark") {
                    document.documentElement.dataset.theme = choice;
                }
            } catch {}
        </script>
    </head>

    <body class="flex min-h-dvh flex-col bg-ground font-sans text-ink antialiased">
        <a
            href="#contenu"
            class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-full focus:bg-accent focus:px-5 focus:py-2 focus:text-sm focus:font-bold focus:text-ground"
        >
            Aller au contenu
        </a>

        <header class="border-b border-rule">
            <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-6 py-4 sm:px-8">
                <a href={withBase("/")} class="display-title text-2xl transition-opacity hover:opacity-70">
                    La Recette du Rythme
                </a>

                <div class="flex items-center gap-2 sm:gap-4">
                    <nav aria-label="Navigation principale">
                        <ul class="flex items-center gap-1">
                            {navigation.map((item) => (
                                <li>
                                    <a
                                        href={item.href}
                                        aria-current={isCurrent(item.href) ? "page" : undefined}
                                        class="rounded-full px-4 py-2 text-sm font-bold transition-colors hover:bg-surface aria-[current=page]:bg-surface"
                                    >
                                        {item.label}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </nav>

                    {/*
                      aria-pressed plutôt qu'un simple bouton : il annonce l'état
                      courant, pas seulement l'action. Le libellé est mis à jour par
                      le script ci-dessous, jamais en dur, pour qu'il reste vrai.
                    */}
                    <button
                        id="theme-toggle"
                        type="button"
                        aria-pressed="false"
                        class="rounded-full border-2 border-ink px-4 py-1.5 text-sm font-bold transition-colors hover:bg-ink hover:text-ground"
                    >
                        Thème
                    </button>
                </div>
            </div>
        </header>

        <main id="contenu" class="mx-auto w-full max-w-6xl grow px-6 py-12 sm:px-8 sm:py-16">
            <slot/>
        </main>

        <footer class="bg-surface">
            <div class="mx-auto flex w-full max-w-6xl flex-col gap-4 px-6 py-10 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-8">
                <p>
                    <span class="display-title text-lg text-ink">La Recette du Rythme</span>
                    <span class="ml-2">— cours en construction</span>
                </p>
                <ul class="flex flex-wrap gap-x-6 gap-y-2 font-semibold">
                    <li>
                        <a href={withBase("/sources")} class="underline decoration-rule decoration-2 underline-offset-4 transition-colors hover:text-ink hover:decoration-accent">
                            Sources
                        </a>
                    </li>
                    <li>
                        <a href={repository} class="underline decoration-rule decoration-2 underline-offset-4 transition-colors hover:text-ink hover:decoration-accent">
                            Code source
                        </a>
                    </li>
                </ul>
            </div>
        </footer>

        {/*
          Une vingtaine de lignes sans framework : le bouton n'a pas besoin d'un
          îlot, donc il n'en aura pas. `is:inline` évite qu'Astro n'en fasse un
          module à télécharger séparément.
        */}
        <script is:inline>
            (() => {
                const root = document.documentElement;
                const button = document.getElementById("theme-toggle");
                if (!button) return;

                const systemDark = window.matchMedia("(prefers-color-scheme: dark)");

                // Le thème effectif : le choix stocké s'il existe, sinon le système.
                const current = () =>
                    root.dataset.theme || (systemDark.matches ? "dark" : "light");

                const render = () => {
                    const dark = current() === "dark";
                    button.textContent = dark ? "Clair" : "Sombre";
                    button.setAttribute("aria-pressed", String(dark));
                    // Le libellé dit ce que le clic va faire ; aria-label dit où
                    // l'on en est. Les deux sont nécessaires et différents.
                    button.setAttribute(
                        "aria-label",
                        dark ? "Thème sombre actif. Passer au thème clair" : "Thème clair actif. Passer au thème sombre",
                    );
                };

                button.addEventListener("click", () => {
                    const next = current() === "dark" ? "light" : "dark";
                    root.dataset.theme = next;
                    try {
                        localStorage.setItem("theme", next);
                    } catch {}
                    render();
                });

                // Tant qu'aucun choix n'a été fait, suivre le système en direct.
                systemDark.addEventListener("change", () => {
                    if (!root.dataset.theme) render();
                });

                render();
            })();
        </script>
    </body>
</html>
